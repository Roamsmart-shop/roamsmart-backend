# AirtelTigo API
AIRTELTIGO_API_KEY=your_airteltigo_api_key
AIRTELTIGO_API_SECRET=your_airteltigo_api_secret
AIRTELTIGO_API_ENDPOINT=https://api.airteltigo.com.gh/v1/data

# ========== AGENT CONFIGURATION ==========
AGENT_REGISTRATION_FEE=100
MIN_WITHDRAWAL_AMOUNT=50
MAX_WITHDRAWAL_AMOUNT=10000

# ========== COMMISSION RATES ==========
BRONZE_COMMISSION=10
SILVER_COMMISSION=15
GOLD_COMMISSION=20
PLATINUM_COMMISSION=25

# ========== REFERRAL BONUS ==========
REFERRAL_BONUS_AMOUNT=5

# ========== SECURITY ==========
# Rate limiting
RATELIMIT_ENABLED=true
RATELIMIT_DEFAULT=100/hour
RATELIMIT_LOGIN=5/minute

# CORS Settings
CORS_ORIGINS=https://roamsmart.shop,https://www.roamsmart.shop
CORS_ALLOW_CREDENTIALS=true

# ========== FEATURE FLAGS ==========
ENABLE_WHATSAPP_BOT=true
ENABLE_AFA_REGISTRATION=true
ENABLE_WAEC_VOUCHERS=true
ENABLE_BILL_PAYMENTS=true

# ========== DEVELOPMENT MODE (Set to false in production) ==========
MOCK_API=false
DEBUG=false
TESTING=false